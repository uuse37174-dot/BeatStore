rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety catch-all: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper methods
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "uuse37174@gmail.com";
    }

    // Journal/Blog posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Shop products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Product categories
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Transaction checkout orders
    match /orders/{orderId} {
      allow create: if true; // Guest users and signed-in users can place checkout orders
      allow read, update, delete: if isAdmin() || request.auth == null || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
    }

    // Admin email audit logs
    match /emailLogs/{logId} {
      allow read, write: if isAdmin() || request.auth == null;
    }

    // Public payment settings & backup QR settings
    match /paymentSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Site texts custom labels
    match /siteTexts/{textId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Dynamic Checkout custom extra text input fields
    match /customInputs/{inputId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Custom database-backed auth fallback users
    match /customUsers/{userId} {
      allow read, write: if true;
    }
  }
}
